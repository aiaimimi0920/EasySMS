{
  "schemaVersion": 1,
  "project": "EasySms",
  "releaseClass": "springbok-cloudflare-workers",
  "sba": {
    "manifestPath": ".sba/manifest.json",
    "manifestSchemaVersion": 3,
    "deploymentPath": ".sba/deployment.json",
    "deploymentSchemaVersion": 2,
    "target": "cloudflare-workers",
    "entrypoint": ".sba/springbok.ps1",
    "requiredActions": [
      "deploy",
      "update",
      "verify",
      "preview",
      "destroy-preview"
    ],
    "requiredResources": [
      "database",
      "backups"
    ]
  },
  "worker": {
    "sourceEntrypoint": "service/base/src/worker/index.ts",
    "buildScript": "service/base/scripts/build-worker.mjs",
    "migrationSql": "service/base/migrations/0001_initial.sql"
  },
  "ci": {
    "validateWorkflow": ".github/workflows/validate.yml"
  }
}
